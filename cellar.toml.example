# Cellar. Copy to cellar.toml and edit.
#
# Secrets are never in this file. They come from the environment:
#
#   CELLAR_DATABASE_URL         mysql://readonly_user:password@host/database
#   CELLAR_GSLT                 Steam Game Server Login Token
#   CELLAR_BRIDGE_SECRET        for bridge.auth = "shared_secret"
#   CELLAR_WEB_PASSWORD_HASH    from `cellar hash-password`
#   CELLAR_DISCORD_WEBHOOK_URL  Discord notifications
#   CELLAR_WEBHOOK_URL          generic JSON notifications

[server]
# Linux, in a container or on a host:
executable = "/home/container/sbox/sbox-server.exe"
project = "/home/container/projects/my-game/my-game.sbproj"
# For a published package, use `game` instead of `project`:
# game = "your-org.your-game"
# map = "thieves.rpdowntown3t"
launcher = "wine"

# Windows, natively:
# executable = 'C:\sbox\sbox-server.exe'
# project = 'C:\Users\Shadow\Desktop\Projects\my-game\my-game.sbproj'
# launcher = "native"

hostname = "My S&box Server"

# The engine's data directory, beside features.json and permissions.json.
# Cellar writes hosting.json here before starting the server. Required when the
# bridge is enabled: without it the gamemode silently keeps using local files.
# data_dir = "/home/container/.local/share/sbox/data"

# Where the engine writes its log. Defaults to <executable dir>/logs/sbox-server.log,
# which is what the engine does unless FACEPUNCH_ENGINE says otherwise.
# log_file = "/home/container/sbox/logs/sbox-server.log"

# Off by default, matching the deployed server: players route through Steam's
# relay and no inbound port is needed. Turn on only if you want the real address
# exposed.
direct_connect = false
port = 27015
query_port = 27016

# The log line that means "serving". Set this to the readiness signal emitted
# by the game when it has finished loading.
ready_pattern = "Lobby created - session is joinable"

# Note: no maxplayers. The engine has no such convar or launch switch; the real
# ceiling is the project's Metadata.MaxPlayers.

[supervisor]
# never | always | on_failure
restart = "on_failure"

# How long a graceful stop waits after `quit` before killing. The engine has
# nine shutdown steps to get through, including the Steam logoff. Kubernetes
# needs terminationGracePeriodSeconds at least this large.
graceful_timeout_seconds = 30
sample_interval_seconds = 2

[supervisor.backoff]
initial = 2
maximum = 120
multiplier = 2.0
crash_loop_threshold = 5
window = 300
healthy_after = 60

[database]
enabled = true
max_connections = 8
# The gamemode owns its tables, migrations, and data contract. Cellar only
# introspects the live schema and runs read-only queries in the web UI.
schema_owner = "gamemode"
migrate_on_start = false
event_retention_days = 90

# Logical MariaDB dumps. The password is never put in the dump command line.
[backup]
enabled = false
# directory = "C:\\ProgramData\\Cellar\\backups"
interval_hours = 24
retain = 7

# Uncomment to have Cellar download, initialize and supervise its own MariaDB
# instead of only connecting to one already running somewhere. `database.url`
# (CELLAR_DATABASE_URL) is unaffected either way; run `cellar mariadb
# provision` once to get a value for it. See docs/CONFIGURATION.md#mariadb.
#
# [mariadb]
# managed = true
# version = "11.4.5"
# sha256 = "…"                    # checked by hand against mariadb.org/download
# install_dir = "C:\\ProgramData\\Cellar\\mariadb\\11.4.5"
# data_dir = "C:\\ProgramData\\Cellar\\mariadb\\data"
# port = 33306

[bridge]
enabled = true

# Loopback, which is what makes "trusted" auth defensible. Cellar refuses to
# start trusted auth on any other address.
bind = "127.0.0.1:8080"

# What gets written into hosting.json for the gamemode to dial. Must be the
# final URL: the engine strips Authorization on every redirect hop.
public_url = "http://127.0.0.1:8080"

# The Auth.GetToken service name. HostingConfigStore refuses a document without one.
auth_audience = "your-game-bridge"

# trusted | shared_secret | facepunch
#
# "trusted" does not verify the token; there is no published endpoint that can.
# It leans on the bridge being unreachable from anywhere but the game host.
# "facepunch" is refused at startup rather than silently downgraded.
auth = "trusted"

# Which server's documents these are. One value today.
scope = "your-game-dev"

max_body_bytes = 1048576
rate_limit_per_minute = 600

[web]
enabled = true
bind = "127.0.0.1:8081"
# auto uses the password when configured, password always requires it, and
# none is accepted only on loopback. Create a hash with `cellar hash-password`.
auth = "auto"

[notify]
enabled = false
# Seconds to gather events before sending, so a join wave is one message.
batch_seconds = 5
# Empty means every notable kind.
kinds = []

[update]
# off | notify | apply. Default is notify: taking an update is opt-in.
policy = "notify"
check_interval_minutes = 60
check_remote = true

# Leave this on. An updater that restarts a server with people on it is worse
# than no updater.
only_when_empty = true

# Local-time hours. Equal values mean any time; 22 to 4 wraps midnight.
window_start_hour = 0
window_end_hour = 0

update_gamemode = true
update_engine = false
# Needed for update_engine and for reading the installed build id.
# steam_dir = "/home/container/sbox"
# steamcmd = "/usr/bin/steamcmd"

[release]
# Cellar runs these without a shell from the configured working directory.
# Supply the exact editor or wrapper commands used by this installation.
# build_command = ["powershell.exe", "-NoProfile", "-File", "C:\\path\\to\\build.ps1"]
# publish_command = ["powershell.exe", "-NoProfile", "-File", "C:\\path\\to\\publish.ps1"]
# working_dir = "C:\\path\\to\\your-game"
